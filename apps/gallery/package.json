{
  "name": "@wabou/gallery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "paraglide-js compile --project ./project.inlang --outdir ./ui/paraglide --strategy baseLocale --is-server false --emit-ts-declarations",
    "build": "vite --config wabou.config.ts build",
    "dev": "vite --config wabou.config.ts --host 127.0.0.1",
    "test:behavior": "cargo run -p wabou-cli -- test ."
  },
  "dependencies": {
    "@wabou/ui": "workspace:*",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "lucide-static": "1.64.0",
    "solid-js": "2.0.0-rc.14"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "^26.6.6",
    "@wabou/test": "workspace:*",
    "@wabou/vite": "workspace:*",
    "vite": "^8.3.5"
  }
}
