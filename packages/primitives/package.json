{
  "name": "@wabou/primitives",
  "version": "0.1.0-alpha.1",
  "description": "Low-level SolidJS UI primitives for Wabou applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/primitives"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./interactions": {
      "wabou-source": "./src/interactions/index.ts",
      "types": "./dist/interactions.d.mts",
      "import": "./dist/interactions.mjs"
    }
  },
  "dependencies": {
    "@floating-ui/core": "^1.8.0",
    "@wabou/animation": "workspace:*",
    "@wabou/core": "workspace:*",
    "solid-js": "2.0.0-rc.0",
    "ts-pattern": "^5.9.0"
  }
}
