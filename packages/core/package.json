{
  "name": "@wabou/core",
  "version": "0.1.0-alpha.1",
  "description": "Core runtime APIs and QuickJS compatibility layer for Wabou.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./protocol": {
      "wabou-source": "./src/protocol.ts",
      "types": "./dist/protocol.d.mts",
      "import": "./dist/protocol.mjs"
    },
    "./effects": {
      "wabou-source": "./src/effects.ts",
      "types": "./dist/effects.d.mts",
      "import": "./dist/effects.mjs"
    },
    "./registry": {
      "wabou-source": "./src/registry.ts",
      "types": "./dist/registry.d.mts",
      "import": "./dist/registry.mjs"
    },
    "./renderer": {
      "wabou-source": "./src/renderer.ts",
      "types": "./dist/renderer.d.mts",
      "import": "./dist/renderer.mjs"
    },
    "./testing": {
      "wabou-source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./style": {
      "wabou-source": "./src/style.ts",
      "types": "./dist/style.d.mts",
      "import": "./dist/style.mjs"
    },
    "./i18n": {
      "wabou-source": "./src/i18n.ts",
      "types": "./dist/i18n.d.mts",
      "import": "./dist/i18n.mjs"
    },
    "./jsx-runtime": {
      "wabou-source": "./src/jsx.ts",
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "wabou-source": "./src/jsx.ts",
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    }
  },
  "dependencies": {
    "@solidjs/universal": "2.0.0-rc.1",
    "@tanstack/virtual-core": "3.17.7",
    "abort-controller": "3.0.0",
    "solid-js": "2.0.0-rc.1",
    "whatwg-url": "^17.1.0"
  }
}
