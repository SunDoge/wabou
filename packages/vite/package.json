{
  "name": "@wabou/vite",
  "version": "0.1.0-alpha.1",
  "description": "Vite integration for Wabou applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "wabou-source": "./src/runtime/client.ts",
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./utility-manifest": {
      "wabou-source": "./src/utility-manifest.ts",
      "types": "./dist/utility-manifest.d.mts",
      "import": "./dist/utility-manifest.mjs"
    }
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@wabou/solid-renderer": "workspace:*",
    "@wabou/style-compiler": "workspace:*",
    "@wabou/unocss-preset": "workspace:*",
    "magic-string": "^0.30.21",
    "smol-toml": "^1.3.1",
    "vite": "^5.4.0",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
