{
  "name": "@wabou/vite",
  "version": "0.1.0-alpha.3",
  "description": "Vite integration for Wabou applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/vite"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./test": {
      "wabou-source": "./src/test.ts",
      "types": "./dist/test.d.mts",
      "import": "./dist/test.mjs"
    },
    "./runtime": {
      "wabou-source": "./src/runtime/client.ts",
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./preset": {
      "wabou-source": "./src/preset/index.ts",
      "types": "./dist/preset.d.mts",
      "import": "./dist/preset.mjs"
    },
    "./utility-manifest": {
      "wabou-source": "./src/utility-manifest.ts",
      "types": "./dist/utility-manifest.d.mts",
      "import": "./dist/utility-manifest.mjs"
    },
    "./config": {
      "wabou-source": "./src/config.ts",
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-packages.ts vite",
    "test": "bun test"
  },
  "dependencies": {
    "@formatjs/intl-datetimeformat": "^7.8.1",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.12",
    "@formatjs/intl-numberformat": "^9.4.3",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@unocss/core": "^66.7.5",
    "@wabou/core": "workspace:*",
    "magic-string": "^1.4.3",
    "smol-toml": "^1.9.1",
    "vite": "^8.3.4",
    "@solidjs/vite-plugin": "3.0.0-next.43"
  }
}
