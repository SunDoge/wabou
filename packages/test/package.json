{
  "name": "@wabou/test",
  "version": "0.1.0-alpha.1",
  "description": "Behavior testing utilities for Wabou applications.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/test"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./component": {
      "wabou-source": "./src/component.ts",
      "types": "./dist/component.d.mts",
      "import": "./dist/component.mjs"
    },
    "./layout": {
      "wabou-source": "./src/layout.ts",
      "types": "./dist/layout.d.mts",
      "import": "./dist/layout.mjs"
    },
    "./layout/node": {
      "wabou-source": "./src/layout-node.ts",
      "types": "./dist/layout-node.d.mts",
      "import": "./dist/layout-node.mjs"
    },
    "./layout/fixtures": {
      "wabou-source": "./src/layout-fixtures.ts",
      "types": "./dist/layout-fixtures.d.mts",
      "import": "./dist/layout-fixtures.mjs"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-packages.ts test"
  },
  "dependencies": {
    "@wabou/core": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": ">=2.0.0-rc.2",
    "vitest": ">=2.1.0"
  }
}
