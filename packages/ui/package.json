{
  "name": "@wabou/ui",
  "version": "0.1.0-alpha.3",
  "description": "The primary application-facing API for Wabou native interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./primitives": {
      "wabou-source": "./src/primitives/index.ts",
      "types": "./dist/primitives.d.mts",
      "import": "./dist/primitives.mjs"
    },
    "./i18n": {
      "wabou-source": "./src/i18n.ts",
      "types": "./dist/i18n.d.mts",
      "import": "./dist/i18n.mjs"
    },
    "./jsx-runtime": {
      "wabou-source": "./src/jsx.ts",
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "wabou-source": "./src/jsx.ts",
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-packages.ts ui"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "@internationalized/number": "^3.5.3",
    "@tanstack/history": "1.162.1",
    "@tanstack/router-core": "1.171.24",
    "@tanstack/table-core": "^8.21.3",
    "@wabou/core": "workspace:*",
    "lucide-static": "1.31.0",
    "marked": "18.0.11",
    "motion-dom": "13.1.1",
    "remend": "1.3.0",
    "solid-js": "2.0.0-rc.2",
    "ts-pattern": "^5.9.0",
    "uqr": "^0.1.3"
  }
}
