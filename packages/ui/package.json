{
  "name": "@wabou/ui",
  "version": "0.1.0-alpha.3",
  "description": "The primary application-facing API for Wabou native interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./primitives": {
      "wabou-source": "./src/primitives/index.ts",
      "types": "./dist/primitives.d.mts",
      "import": "./dist/primitives.mjs"
    },
    "./i18n": {
      "wabou-source": "./src/i18n.ts",
      "types": "./dist/i18n.d.mts",
      "import": "./dist/i18n.mjs"
    },
    "./jsx-runtime": {
      "wabou-source": "./src/jsx.ts",
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./jsx-dev-runtime": {
      "wabou-source": "./src/jsx.ts",
      "types": "./dist/jsx-runtime.d.mts",
      "import": "./dist/jsx-runtime.mjs"
    },
    "./performance": {
      "wabou-source": "./src/performance.ts",
      "types": "./dist/performance.d.mts",
      "import": "./dist/performance.mjs"
    }
  },
  "scripts": {
    "build": "bun run ../../scripts/build-packages.ts ui"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.9",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/json": "^1.0.3",
    "@tanstack/history": "1.162.4",
    "@tanstack/router-core": "1.171.34",
    "@tanstack/table-core": "^9.2.8",
    "@wabou/core": "workspace:*",
    "lucide-static": "1.53.0",
    "marked": "18.1.0",
    "motion-dom": "13.1.1",
    "remend": "1.4.0",
    "solid-js": "2.0.0-rc.14",
    "ts-pattern": "^5.9.0",
    "uqr": "^0.1.3"
  }
}
