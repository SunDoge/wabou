{
  "name": "@wabou/unocss-preset",
  "version": "0.1.0-alpha.1",
  "description": "UnoCSS preset matching Wabou's native style vocabulary.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SunDoge/wabou.git",
    "directory": "packages/unocss-preset"
  },
  "publishConfig": {
    "access": "public"
  },
  "wabou": {
    "stability": "internal"
  },
  "type": "module",
  "files": [
    "dist",
    "generated/manifest.json"
  ],
  "exports": {
    ".": {
      "wabou-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./manifest": {
      "wabou-source": "./generated/manifest.json",
      "default": "./generated/manifest.json"
    }
  },
  "dependencies": {
    "@unocss/core": "^66.7.5"
  }
}
