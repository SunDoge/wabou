{
  "name": "__WABOU_PROJECT_NAME__",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "vendor/wabou/packages/*"
  ],
  "scripts": {
    "wabou": "wabou",
    "dev": "wabou dev",
    "build": "wabou bundle . --out dist/app",
    "build:static": "wabou bundle . --static --out dist/static-app",
    "check:ui": "tsc --noEmit",
    "check:native": "cargo check --manifest-path native/Cargo.toml",
    "check": "wabou check",
    "doctor": "wabou doctor",
    "test": "wabou test .",
    "run": "wabou run"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.14",
    "@wabou/ui": "workspace:*",
    "solid-js": "2.0.0-rc.14"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@wabou/vite": "workspace:*",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "@wabou/test": "workspace:*"
  }
}
