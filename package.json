{
  "name": "wabou",
  "private": true,
  "type": "module",
  "scripts": {
    "wabou": "cargo run -p wabou-cli --",
    "format": "biome format --write .",
    "check": "bun x tsc --noEmit",
    "check:all": "bun x tsc --noEmit",
    "test:solid2": "bun --conditions=browser test packages/solid-renderer/src/events.test.ts packages/core/src/glue/host-frame.test.ts",
    "test": "bun test --conditions=browser packages apps/*/ui",
    "ci:local": "bash scripts/run-act.sh",
    "commit:check": "cog check",
    "commit:hook": "cog install-hook commit-msg",
    "test:hmr": "bun --conditions=browser --conditions=development test packages/solid-renderer/src/hmr.test.ts",
    "test:router": "bun --conditions=browser test packages/router/src/index.test.tsx",
    "packages:build": "node node_modules/tsdown/dist/run.mjs",
    "packages:check": "bun run scripts/check-package-boundaries.ts && tsc -p tests/package-consumer/tsconfig.json",
    "size:report": "bun run scripts/report-artifact-sizes.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release-packages": "bun run packages:build && bun run packages:check && bun run scripts/publish-packages.ts",
    "gen:source": "bun run scripts/codegen/index.ts",
    "gen": "bun run gen:source && bun run packages:build",
    "gen:check": "bun run scripts/check-generated.ts",
    "build": "bun run gen && bun run wabou build apps/gallery",
    "dev": "bun run wabou dev apps/gallery"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/cli": "^2.29.8",
    "@solidjs/web": "2.0.0-rc.0",
    "@tanstack/history": "1.162.1",
    "@tanstack/router-core": "1.171.24",
    "@types/bun": "^1.3.14",
    "@wabou/components": "workspace:*",
    "@wabou/core": "workspace:*",
    "@wabou/solid-renderer": "workspace:*",
    "@wabou/unocss-preset": "workspace:*",
    "@wabou/vite": "workspace:*",
    "bun-types": "^1.3.14",
    "solid-js": "2.0.0-rc.0",
    "tsdown": "0.22.14",
    "typescript": "^5.9.0",
    "unocss": "^66.7.5",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
