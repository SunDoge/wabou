{
  "name": "wabou",
  "private": true,
  "scripts": {
    "wabou": "cargo run -p wabou-cli --",
    "format": "biome format --write .",
    "check": "bun x tsc --noEmit",
    "test": "bun --conditions=browser test",
    "commit:check": "cog check",
    "commit:hook": "cog install-hook commit-msg",
    "test:solid-refresh": "bun --conditions=browser --conditions=development test packages/solid-renderer/src/hmr.test.ts",
    "test:router": "bun --conditions=browser test packages/router/src/index.test.tsx",
    "gen": "bun run scripts/codegen/index.ts",
    "build": "bun run gen && bun run wabou build --app-dir apps/gallery",
    "dev": "bun run wabou dev --app-dir apps/gallery"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "^1.3.14",
    "@wabou/unocss-preset": "workspace:*",
    "bun-types": "^1.3.14",
    "unocss": "^66.7.5"
  }
}
